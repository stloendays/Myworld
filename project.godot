; Engine configuration file.
; Dusk Lake — Godot 4.7.2 Standard (GDScript), Windows 单机优先。

config_version=5

[application]

config/name="Dusk Lake"
config/description="A quiet lakeside world to explore alone or with up to three friends."
config/version="0.3.4-rc.1"
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://installer/icon.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="DuskLake"

[autoload]

GameSettings="*res://scripts/core/GameSettings.gd"
StartupDiagnostics="*res://scripts/core/StartupDiagnostics.gd"
EventBus="*res://scripts/core/EventBus.gd"
WorldState="*res://scripts/core/WorldState.gd"
PlayerProfile="*res://scripts/core/PlayerProfile.gd"
Net="*res://scripts/net/NetworkManager.gd"
Updater="*res://scripts/core/Updater.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900

[internationalization]

locale/translations=PackedStringArray("res://locale/en.po")
locale/fallback="zh"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="actors"
3d_physics/layer_3="interactable"
3d_physics/layer_4="water_limit"
3d_physics/layer_5="terrain"
3d_render/layer_1="world"
3d_render/layer_2="water"
3d_render/layer_3="player_body"
3d_render/layer_4="falling_leaves"
3d_render/layer_5="first_person_arms"

[shader_globals]

rain_amount={
"type": "float",
"value": 0.0
}
snow_fall={
"type": "float",
"value": 0.0
}
snow_cover={
"type": "float",
"value": 0.0
}
wetness={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.0
}
wind_direction={
"type": "vec2",
"value": Vector2(0.8, 0.6)
}
lightning_flash={
"type": "float",
"value": 0.0
}
season_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
[physics]

3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
occlusion_culling/use_occlusion_culling=true
reflections/reflection_atlas/reflection_size=1024
reflections/reflection_atlas/reflection_count=2
